{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "strict": true,
    "paths": {
      "@harbor-play-media/shared-api": ["libs/shared-api/src/index.ts"],
      "@harbor-play-media/common": ["libs/auth/common/src/index.ts"],
      "@harbor-play-media/nest": ["libs/auth/nest/src/index.ts"],
      "@harbor-play-media/angular": ["libs/auth/angular/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
